{% extends "@Contao/frontend_module/_base.html.twig" %}

{% block content %}
    {% add "staging_installation_banner_css" to head %}
        <link rel="stylesheet" href="{{ asset('css/fe_stylesheet.css', 'markocupic_contao_staging_installation_banner') }}">
    {% endadd %}
    {% set banner_attributes = attrs()
        .addClass('staging_installation_banner--inner')
        .setIfExists('style', banner_style|default)
        .mergeWith(banner_attributes|default)
    %}
    <div{% block banner_attributes %}{{ banner_attributes }}{% endblock %}>
        {% block banner_icon %}<img class="staging_installation_banner--icon" src="{{ asset('icons/icon.svg', 'markocupic_contao_staging_installation_banner') }}" alt="">{% endblock %}
        {% block banner_text %}<span class="staging_installation_banner--banner_text">{{ bannerText }}</span>{% endblock %}
    </div>
{% endblock %}
